# Copy to .env and fill in real values. Never commit .env.
# Plain KEY=VALUE lines (no `export`, no inline comments); real environment
# variables always win over this file.

# Neon connection string. Neon requires TLS, so keep sslmode=require.
# Use the pooled endpoint for the API and worker.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/sutra?sslmode=require

# Port the Go API listens on.
PORT=8080

# Accounting software API. Point this at the mock server for local development.
ACCOUNTING_BASE_URL=http://localhost:8090

# Per-request timeout for the accounting API. Deliberately longer than the
# mock's 5s hang so a hung-but-successful call is still recorded; other
# vouchers keep moving because the worker pushes concurrently.
ACCOUNTING_TIMEOUT=8s

# Attempts before a voucher is parked as failed.
ACCOUNTING_MAX_ATTEMPTS=5

# How many vouchers one worker instance pushes at once.
WORKER_CONCURRENCY=4

# Stretch: POST /ask. Leave blank to run with the stubbed model.
LLM_API_KEY=
LLM_MODEL=
